{
  "name": "halloween-ar-suit",
  "private": true,
  "version": "0.1.0",
  "description": "WebAR Halloween costume: scan the chest/back marker, see the wearer in a rigged 3D suit.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install three @mediapipe/tasks-vision && npm install -D vite typescript @types/three @vitejs/plugin-basic-ssl && npm run assets",
    "assets": "node scripts/fetch-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/*.test.ts\""
  },
  "homepage": "https://halloween-ruby.vercel.app",
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "meshoptimizer": "^1.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
